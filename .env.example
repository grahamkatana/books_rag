# ============================================================
# Book RAG -- environment template. Copy to `.env` and fill in.
# `.env` is gitignored AND dockerignored -- never commit real keys.
# Generate real secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# --- Database ---
# SQLite by default for bare-host use (`uv run python server.py`). The
# Dockerized / k8s path overrides this to point at the postgres service.
DATABASE_URL=sqlite:///./book_rag.db

# Postgres service password (docker-compose.yml / k8s postgres only).
# Pick a real password before exposing this anywhere reachable by others.
POSTGRES_PASSWORD=book_rag_dev_password

# --- Primary LLM + embeddings (OpenAI) ---
# Used for chat answers, claim extraction, verification, AND embeddings.
OPENAI_API_KEY=sk-...
DEFAULT_CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# --- Cross-check agent (DeepSeek -- cheap independent second opinion) ---
# Replaces Anthropic/Claude. DeepSeek is OpenAI-compatible; pydantic-ai
# points its OpenAI provider at DeepSeek's own base URL.
DEEPSEEK_API_KEY=sk-...
CROSS_CHECK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Document-context agent (Gemini -- cheap orientation pass) ---
# Gemini 2.5 Flash-Lite has a free tier; this stage should cost ~nothing.
GOOGLE_API_KEY=
CONTEXT_MODEL=gemini-2.5-flash-lite
MAX_CONTEXT_INPUT_CHARS=100000

# --- Bibliography lookup (optional) ---
# Brave Search powers automatic book-bibliography lookup; without it the
# step is skipped and books fall back to filename guessing. SerpApi is an
# optional fallback for lookup-bibliography / lookup-paper-doi.
BRAVE_API_KEY=
SERPAPI_API_KEY=

# --- Qdrant ---
# Local docker-compose default: http://localhost:6333. In k8s point at the
# shared instance, e.g. http://qdrant.qdrant.svc.cluster.local:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=book_library
PAPERS_QDRANT_COLLECTION=paper_library
QDRANT_TIMEOUT=30

# --- Chunking / retrieval ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
DEFAULT_TOP_K=6

# --- Auth ---
# JWT secret for the API, session secret for the Flask-Admin panel.
# Generate real values before deploying beyond your own machine.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me
SECRET_KEY=dev-only-insecure-flask-secret-change-me

# --- Redis / Celery (admin background jobs) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0   # set directly to override the pieces above
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Crossref (paper DOI lookup; no key needed) ---
# Optional "polite pool" email for more reliable rate-limit treatment.
CROSSREF_MAILTO=

# --- Logging (rotating JSON file -> Promtail/Loki/Grafana) ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Grafana (docker-compose only; production Grafana is separate) ---
GRAFANA_ADMIN_PASSWORD=admin
