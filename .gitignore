# Secrets / local config
.env

# Local database
book_rag.db
*.db-journal

# Generated data (regeneratable from pdfs/books/ via the CLI)
data/report.csv
data/chunks/

# Keep the books people actually own out of version control too
pdfs/books/*.pdf

# Same as above, for the papers pipeline
data/papers/report.csv
data/papers/chunks/
pdfs/papers/*.pdf

# The corpus dirs themselves are symlinks to local absolute paths --
# machine-specific, so ignore the symlinks too (not just their contents).
pdfs/books
pdfs/papers

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS noise
.DS_Store

# uv
.venv/

# frontend
frontend/node_modules/
frontend/dist/

# generated chunk manifest (regeneratable, tied to local pdfs/books/ content)
data/chunks/.manifest.json

# logs (rotating files, generated at runtime)
logs/
*.docx
backups/

# local-run scripts + resume notes (contain secrets/creds, host-only)
run_step.sh
RESUME.md
continue.md
# Android app (android/): build output and signing material must never be committed.
# android/.gitignore says the same; this is the safety net if that file is ever edited or lost.
android/**/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/keystore.properties
*.jks
*.keystore
*.p12
*.apk
